# Configure estas variáveis na Vercel e no arquivo .env.local.
# Nunca envie valores reais para o GitHub.

NEXT_PUBLIC_APP_NAME=Kairos Agent
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (obrigatórias para login e dados)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# OpenAI (necessária para os recursos de IA)
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

SUPABASE_STORAGE_BUCKET=documents
